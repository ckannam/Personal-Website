---
import Base from '../layouts/Base.astro';
import GraphHero from '../components/GraphHero.tsx';
import { buildGraph } from '../data/graph';

const { nodes, links } = await buildGraph();
---

<Base>
  <section class="hero">
    <div class="hero__graph">
      <GraphHero client:only="react" nodes={nodes} links={links} />
    </div>

    <div class="hero__id">
      <p class="hero__name">Cole Kannam</p>
      <h1 class="hero__headline">
        <span class="neuro">Neuro</span> × <span class="ai">AI</span>
      </h1>
      <p class="hero__sub">
        A neuroscientist who brings AI into every room he's in. Published brain research,
        a company, venture work — one connected story.
      </p>
    </div>

    <div class="hero__foot">
      <span class="legend neuro">Neuroscience</span>
      <span class="legend venture">Ventures</span>
      <span class="legend ai">AI</span>
      <span class="hint">Drag a node. Click one to read its story.</span>
    </div>
  </section>
</Base>
