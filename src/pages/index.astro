---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import NodeCard from '../components/NodeCard.astro';
import Contact from '../components/Contact.astro';
import { getCollection, render } from 'astro:content';

const nodes = await getCollection('nodes');
const chapters = await getCollection('chapters');
const bySlug = (s: string) => chapters.find((c) => c.data.slug === s)!;

const ORDER = [
  'duke-neuro-chem',
  'wilcox-jaacap',
  'marsh-thesis',
  'fmri',
  'cipher-poster',
  'ushipping',
  'jhtv-pitchbook',
  'atp',
  'second-brain',
];
const rank = (id: string) => ORDER.indexOf(id);
const inLobe = (l: string) =>
  nodes.filter((n) => n.data.lobe === l).sort((a, b) => rank(a.data.id) - rank(b.data.id));

const research = inLobe('neuro');
const ventures = [...inLobe('venture'), ...inLobe('ai')];

const whoIAm = await render(bySlug('who-i-am'));
const theNeuroscience = await render(bySlug('the-neuroscience'));
const howIThink = await render(bySlug('how-i-think'));
const whereTheyMeet = await render(bySlug('where-they-meet'));
---

<Base>
  <a class="skip" href="#top">Skip to content</a>

  <Nav />

  <header id="top" class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="eyebrow">DUKE NEUROSCIENCE '27 · BALTIMORE</p>
        <h1 class="hero__headline">Neuro <span class="x">×</span> AI</h1>
        <p class="hero__role">Neuroscientist who builds.</p>
        <p class="hero__intro">
          Published brain research, a company I run, and venture work — I bring AI into every
          seat I sit in. Everything I've done is one connected story.
        </p>
        <div class="hero__cta">
          <a class="btn" href="#work">See the work</a>
          <a class="btn btn--ghost" href="/resume">Résumé</a>
        </div>
      </div>

      <figure class="hero__figure">
        <img
          class="hero__photo"
          src="/assets/cole-headshot.png"
          width="592"
          height="580"
          alt="Cole Kannam"
          fetchpriority="high"
        />
      </figure>
    </div>
  </header>

  <section class="band">
    <div class="wrap band__in reveal">
      <whoIAm.Content />
    </div>
  </section>

  <section id="work" class="section">
    <div class="wrap">
      <div class="section__head reveal">
        <h2>Ventures &amp; building</h2>
        <div class="section__lede"><howIThink.Content /></div>
      </div>
      <div class="cards">
        {ventures.map((entry) => <NodeCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="band band--accent">
    <div class="wrap band__in reveal">
      <whereTheyMeet.Content />
    </div>
  </section>

  <section id="research" class="section">
    <div class="wrap">
      <div class="section__head reveal">
        <h2>Research</h2>
        <div class="section__lede"><theNeuroscience.Content /></div>
      </div>
      <div class="cards">
        {research.map((entry) => <NodeCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section id="about" class="section about">
    <div class="wrap about__single reveal">
      <div>
        <h2>About</h2>
        <p>
          I'm a Duke senior from Baltimore studying neuroscience, with minors in chemistry and
          entrepreneurship. I came for medicine and stayed for how the brain actually works —
          then learned to build with AI on top of it. I care about doing real science and
          shipping real things, and I don't think you have to choose.
        </p>
        <p>
          Away from the desk: soccer (Chelsea, for my sins), golf in the low 90s, and a steady
          diet of cerebral films and stand-up.
        </p>
      </div>
    </div>
  </section>

  <section id="next" class="section next">
    <div class="wrap next__in reveal">
      <p class="eyebrow">WHAT I WANT TO DO NEXT</p>
      <h2 class="next__headline">
        I want to spend my career on the bridge between science and the market.
      </h2>
      <p class="next__body">
        Right after Duke, that means joining a team building something ambitious at the
        science and AI intersection and helping it grow. Longer term, I want to build that
        bridge at scale: helping real research reach the people it can actually help, whether
        that's backing founders or building my own. <em>(Placeholder — we'll sharpen this.)</em>
      </p>
    </div>
  </section>

  <Contact />

  <footer class="footer">
    <div class="wrap footer__in">
      <span>Cole Kannam</span>
      <span class="footer__meta">Duke · Neuro × AI</span>
    </div>
  </footer>

  <script>
    import { initReveals } from '../scripts/reveal.mjs';
    initReveals();
  </script>
</Base>
