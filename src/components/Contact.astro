---
import { getCollection, render } from 'astro:content';

const chapters = await getCollection('chapters');
const contact = chapters.find((c) => c.data.slug === 'contact')!;
const { Content } = await render(contact);

// Phone is stored base64-encoded so the raw digits never appear in the HTML source.
const phoneB64 = Buffer.from('443-682-2254').toString('base64');
---

<section id="contact" class="section contact">
  <div class="wrap reveal">
    <h2>Contact</h2>
    <div class="contact__lede"><Content /></div>

    <dl class="contact__list">
      <div class="contact__row">
        <dt>Email</dt>
        <dd>
          <button class="copy" type="button" data-copy="cole.kannam@duke.edu" data-label="Email">
            cole.kannam@duke.edu
          </button>
        </dd>
      </div>
      <div class="contact__row">
        <dt>Phone</dt>
        <dd>
          <button class="copy copy--phone" type="button" data-p={phoneB64} data-label="Number">
            Show number
          </button>
        </dd>
      </div>
      <div class="contact__row">
        <dt>LinkedIn</dt>
        <dd>
          <a href="https://www.linkedin.com/in/cole-kannam-960238300/" target="_blank" rel="noopener">
            in/cole-kannam
          </a>
        </dd>
      </div>
      <div class="contact__row">
        <dt>Résumé</dt>
        <dd>
          <a href="/assets/Cole_Kannam_Resume.pdf" target="_blank" rel="noopener">View</a>
          <span class="sep">·</span>
          <a href="/assets/Cole_Kannam_Resume.pdf" download>Download</a>
        </dd>
      </div>
    </dl>
  </div>

  <div class="toast" role="status" aria-live="polite"></div>
</section>

<script>
  const toast = document.querySelector<HTMLDivElement>('.toast');
  let hideTimer: number | undefined;
  function flash(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('is-visible');
    window.clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 1800);
  }
  async function copyText(text: string, label: string) {
    try {
      await navigator.clipboard.writeText(text);
      flash(`${label} copied`);
    } catch {
      flash('Copy failed — select and copy manually');
    }
  }
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((btn) => {
    btn.addEventListener('click', () => {
      let text = btn.dataset.copy ?? '';
      if (btn.dataset.p) {
        text = atob(btn.dataset.p);
        btn.textContent = text; // reveal the number on first click
      }
      copyText(text, btn.dataset.label ?? 'Copied');
    });
  });
</script>
